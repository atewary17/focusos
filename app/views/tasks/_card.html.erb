<% return_to = local_assigns[:return_to] || "board" %>
<div data-task-id="<%= task.id %>"
     class="cursor-grab touch-none select-none rounded-xl border border-stone-200 bg-white p-3 shadow-sm active:cursor-grabbing <%= 'opacity-50' if task.status == 'done' %>">
  <% if task.starts_at %>
    <p class="mb-1 text-xs font-medium text-stone-400"><%= task.starts_at.in_time_zone.strftime("%-l:%M %P") %></p>
  <% end %>

  <div class="flex items-start justify-between gap-2">
    <div class="flex items-start gap-2">
      <%= button_to toggle_task_path(task), method: :patch, params: { return_to: return_to },
            class: "mt-0.5 shrink-0 cursor-pointer text-stone-300 hover:text-teal-600 #{'text-teal-600' if task.status == 'done'}",
            form: { class: "leading-none" } do %>
        <%= task.status == "done" ? "●" : "○" %>
      <% end %>
      <p class="text-sm font-medium text-stone-900 <%= 'line-through' if task.status == 'done' %>"><%= task.title %></p>
    </div>
    <div class="flex shrink-0 items-center gap-1.5">
      <% if task.estimate_minutes %>
        <span class="rounded bg-stone-100 px-1.5 py-0.5 text-xs text-stone-500"><%= task.estimate_minutes %>m</span>
      <% end %>
      <%= button_to task_path(task), method: :delete, title: "Delete card", params: { return_to: return_to },
            class: "cursor-pointer rounded px-1 text-stone-300 hover:bg-red-50 hover:text-red-500",
            form: { class: "leading-none" } do %>
        🗑
      <% end %>
    </div>
  </div>

  <% if task.subtasks.any? %>
    <ul class="mt-2 space-y-1 pl-6">
      <% task.subtasks.each_with_index do |subtask, index| %>
        <li class="flex items-center gap-1.5 text-xs text-stone-600">
          <%= button_to task_toggle_task_subtask_path(task, subtask_id: index), method: :patch, params: { return_to: return_to },
                class: "cursor-pointer #{subtask['done'] ? 'text-teal-600' : 'text-stone-300'}", form: { class: "leading-none" } do %>
            <%= subtask["done"] ? "✓" : "○" %>
          <% end %>
          <span class="<%= 'text-stone-400 line-through' if subtask["done"] %>"><%= subtask["text"] %></span>
          <%= button_to task_task_subtask_path(task, subtask_id: index), method: :delete, params: { return_to: return_to },
                class: "ml-auto cursor-pointer text-stone-300 hover:text-stone-500", form: { class: "leading-none" } do %>×<% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with url: task_subtasks_path(task), class: "mt-2 pl-6" do %>
    <%= hidden_field_tag :return_to, return_to %>
    <%= text_field_tag :text, nil, placeholder: "+ subtask", autocomplete: "off",
          class: "w-full border-0 border-b border-transparent bg-transparent text-xs text-stone-500 placeholder:text-stone-400 focus:border-stone-300 focus:outline-none" %>
  <% end %>

  <div class="mt-2 flex flex-wrap items-center gap-1.5 text-xs text-stone-500">
    <% if task.subject %>
      <span class="inline-flex items-center gap-1 rounded-full bg-stone-100 px-2 py-0.5">
        <span class="inline-block h-2 w-2 rounded-full" style="background: <%= task.subject.color %>"></span>
        <%= task.subject.name %>
      </span>
    <% end %>
    <% if task.priority %>
      <span class="rounded-full bg-amber-50 px-2 py-0.5 text-amber-700">P<%= task.priority %></span>
    <% end %>
    <% if task.energy %>
      <span class="rounded-full bg-stone-100 px-2 py-0.5"><%= task.energy == "high" ? "⚡ high" : "🌙 low" %></span>
    <% end %>
    <% if task.due_on %>
      <span class="rounded-full px-2 py-0.5 <%= task.due_on <= Date.current ? 'bg-red-50 text-red-700' : 'bg-stone-100' %>">
        due <%= task.due_on.strftime("%-d %b") %>
      </span>
    <% end %>
  </div>
</div>
