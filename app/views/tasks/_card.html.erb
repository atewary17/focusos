<div data-task-id="<%= task.id %>"
     class="cursor-grab touch-none select-none rounded-xl border border-stone-200 bg-white p-3 shadow-sm active:cursor-grabbing">
  <div class="flex items-start justify-between gap-2">
    <p class="text-sm font-medium text-stone-900"><%= task.title %></p>
    <%= button_to "×", task_path(task), method: :delete,
          form: { data: { turbo_confirm: "Remove this card?" } },
          class: "shrink-0 cursor-pointer rounded px-1 text-stone-400 hover:bg-stone-100 hover:text-stone-600" %>
  </div>

  <div class="mt-2 flex flex-wrap items-center gap-1.5 text-xs text-stone-500">
    <% if task.subject %>
      <span class="inline-flex items-center gap-1 rounded-full bg-stone-100 px-2 py-0.5">
        <span class="inline-block h-2 w-2 rounded-full" style="background: <%= task.subject.color %>"></span>
        <%= task.subject.name %>
      </span>
    <% end %>
    <% if task.priority %>
      <span class="rounded-full bg-amber-50 px-2 py-0.5 text-amber-700">P<%= task.priority %></span>
    <% end %>
    <% if task.estimate_minutes %>
      <span class="rounded-full bg-stone-100 px-2 py-0.5"><%= task.estimate_minutes %>m</span>
    <% end %>
    <% if task.energy %>
      <span class="rounded-full bg-stone-100 px-2 py-0.5"><%= task.energy == "high" ? "⚡ high" : "🌙 low" %></span>
    <% end %>
    <% if task.due_on %>
      <span class="rounded-full px-2 py-0.5 <%= task.due_on <= Date.current ? 'bg-red-50 text-red-700' : 'bg-stone-100' %>">
        due <%= task.due_on.strftime("%-d %b") %>
      </span>
    <% end %>
  </div>
</div>
