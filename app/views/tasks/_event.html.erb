<%
  local_start = task.starts_at.in_time_zone
  top = local_start.hour * 60 + local_start.min - start_hour * 60
  duration = task.estimate_minutes || 30
  height = [ duration, 24 ].max
  column, total_columns = local_assigns[:columns_by_task_id]&.[](task.id) || [ 0, 1 ]
  width_pct = 100.0 / total_columns
  tooltip = "#{task.title} · #{local_start.strftime("%-l:%M %P")} · #{duration}m"
%>
<div data-calendar-target="event" data-task-id="<%= task.id %>" data-duration="<%= duration %>" title="<%= tooltip %>"
     class="group absolute cursor-grab touch-none overflow-hidden rounded-md px-1.5 py-1 text-[11px] leading-tight text-white shadow transition-shadow hover:z-10 hover:shadow-lg active:cursor-grabbing <%= 'opacity-60' if task.status == 'done' %>"
     style="top: <%= top %>px; height: <%= height %>px; left: calc(<%= column * width_pct %>% + 1px); width: calc(<%= width_pct %>% - 2px); background: <%= task.subject&.color || "#44403c" %>">
  <div class="flex items-start justify-between gap-1">
    <%= button_to toggle_task_path(task), method: :patch, params: { return_to: "calendar" },
          class: "shrink-0 cursor-pointer leading-none text-white/80 hover:text-white", form: { class: "leading-none" } do %>
      <%= task.status == "done" ? "●" : "○" %>
    <% end %>
    <p class="min-w-0 flex-1 truncate font-medium <%= 'line-through' if task.status == 'done' %>"><%= task.title %></p>
    <%= button_to task_path(task), method: :delete, title: "Delete", params: { return_to: "calendar" },
          class: "shrink-0 cursor-pointer leading-none text-white/70 hover:text-white", form: { class: "leading-none" } do %>×<% end %>
  </div>
  <% if height >= 36 %>
    <p class="text-white/80"><%= local_start.strftime("%-l:%M %P") %> · <%= duration %>m</p>
  <% end %>
  <div data-calendar-resize class="absolute inset-x-0 -bottom-1 flex h-3 cursor-ns-resize items-end justify-center pb-0.5">
    <span class="h-0.5 w-5 rounded-full bg-white/0 group-hover:bg-white/70"></span>
  </div>
</div>
