<%
  local_start = task.starts_at.in_time_zone
  top = local_start.hour * 60 + local_start.min - start_hour * 60
  duration = task.estimate_minutes || 30
  height = [ duration, 20 ].max
%>
<div data-calendar-target="event" data-task-id="<%= task.id %>" data-duration="<%= duration %>"
     class="absolute left-0.5 right-0.5 cursor-grab touch-none overflow-hidden rounded-md px-1.5 py-1 text-[11px] leading-tight text-white shadow active:cursor-grabbing <%= 'opacity-60' if task.status == 'done' %>"
     style="top: <%= top %>px; height: <%= height %>px; background: <%= task.subject&.color || "#44403c" %>">
  <div class="flex items-start justify-between gap-1">
    <%= button_to toggle_task_path(task), method: :patch, params: { return_to: "calendar" },
          class: "shrink-0 cursor-pointer leading-none text-white/80 hover:text-white", form: { class: "leading-none" } do %>
      <%= task.status == "done" ? "●" : "○" %>
    <% end %>
    <p class="min-w-0 flex-1 truncate font-medium <%= 'line-through' if task.status == 'done' %>"><%= task.title %></p>
    <%= button_to task_path(task), method: :delete, title: "Delete", params: { return_to: "calendar" },
          class: "shrink-0 cursor-pointer leading-none text-white/70 hover:text-white", form: { class: "leading-none" } do %>×<% end %>
  </div>
  <% if height >= 36 %>
    <p class="text-white/80"><%= local_start.strftime("%-l:%M %P") %> · <%= duration %>m</p>
  <% end %>
  <div data-calendar-resize class="absolute inset-x-0 bottom-0 h-2 cursor-ns-resize"></div>
</div>
