<% content_for :title, "Calendar" %>
<%
  grid_height = (@end_hour - @start_hour) * 60
  format_hour = ->(hour) { Time.zone.local(2000, 1, 1, hour).strftime("%-l %P") }
%>

<div class="mb-6 flex items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">Calendar</h1>
  <div class="flex items-center gap-4">
    <%= link_to "Board", board_path, class: "text-sm font-medium text-teal-700 hover:text-teal-800" %>
    <%= link_to "Subjects & topics", subjects_path, class: "text-sm font-medium text-teal-700 hover:text-teal-800" %>
  </div>
</div>

<div class="mb-4 flex items-center justify-between gap-3">
  <div class="flex items-center gap-2">
    <%= link_to "‹", calendar_path(start: (@week_start - 7).iso8601),
          class: "rounded-lg border border-stone-300 px-2.5 py-1 text-sm text-stone-600 hover:bg-stone-50" %>
    <%= link_to "Today", calendar_path, class: "rounded-lg border border-stone-300 px-3 py-1 text-sm text-stone-600 hover:bg-stone-50" %>
    <%= link_to "›", calendar_path(start: (@week_start + 7).iso8601),
          class: "rounded-lg border border-stone-300 px-2.5 py-1 text-sm text-stone-600 hover:bg-stone-50" %>
  </div>
  <p class="text-sm text-stone-500"><%= @week_start.strftime("%-d %b") %> – <%= (@week_start + 6).strftime("%-d %b %Y") %></p>
</div>

<% if @subjects.none? %>
  <section class="mb-6 rounded-2xl border border-dashed border-stone-300 p-5 text-sm text-stone-600">
    No subjects yet. <%= link_to "Add one", subjects_path, class: "font-medium text-teal-700" %> to tag cards, or add a card below without one.
  </section>
<% end %>

<div data-controller="calendar" data-calendar-start-hour-value="<%= @start_hour %>"
     data-calendar-reschedule-url-template-value="<%= reschedule_task_path(0) %>"
     data-calendar-update-url-template-value="<%= task_path(0) %>"
     class="flex gap-4">
  <aside class="w-56 shrink-0">
    <h2 class="mb-2 flex items-center justify-between text-sm font-semibold text-stone-700">
      Unscheduled
      <span class="text-xs font-normal text-stone-400"><%= @unscheduled.size %></span>
    </h2>
    <%= render "quick_add", subjects: @subjects %>
    <div data-calendar-target="sidebar" class="space-y-2">
      <%= render partial: "tasks/card", collection: @unscheduled, as: :task, locals: { return_to: "calendar" } %>
    </div>
  </aside>

  <div class="flex flex-1 gap-px overflow-x-auto rounded-xl border border-stone-200 bg-stone-200">
    <div class="w-12 shrink-0 bg-white">
      <div class="h-10"></div>
      <div class="relative" style="height: <%= grid_height %>px">
        <% (@start_hour..@end_hour).each do |hour| %>
          <p class="absolute inset-x-0 -translate-y-1/2 pr-1 text-right text-[10px] text-stone-400" style="top: <%= (hour - @start_hour) * 60 %>px">
            <%= format_hour.call(hour) %>
          </p>
        <% end %>
      </div>
    </div>

    <% @days.each do |date| %>
      <div class="min-w-[120px] flex-1 bg-white">
        <div class="h-10 border-b border-stone-100 px-1 py-1 text-center">
          <p class="text-xs font-semibold text-stone-700"><%= date.strftime("%a") %></p>
          <p class="text-[11px] <%= date == Date.current ? "font-semibold text-teal-700" : "text-stone-400" %>"><%= date.day %></p>
        </div>
        <div data-calendar-target="day" data-date="<%= date.iso8601 %>" class="relative" style="height: <%= grid_height %>px">
          <% (@start_hour..@end_hour).each do |hour| %>
            <div class="absolute inset-x-0 border-t border-stone-100" style="top: <%= (hour - @start_hour) * 60 %>px"></div>
          <% end %>
          <%= render partial: "tasks/event", collection: @scheduled_by_day[date], as: :task, locals: { start_hour: @start_hour } %>
        </div>
      </div>
    <% end %>
  </div>
</div>
