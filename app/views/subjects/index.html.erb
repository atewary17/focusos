<% content_for :title, "Subjects & topics" %>

<div class="mb-6 flex items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">Subjects & topics</h1>
  <%= link_to "Plan", plan_path, class: "text-sm font-medium text-teal-700 hover:text-teal-800" %>
</div>

<section class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-stone-200 bg-white p-4 text-sm shadow-sm">
  <div>
    <p class="font-medium text-stone-700">Your plan as a file</p>
    <p class="text-xs text-stone-400">Back it up, or reuse it as a starting template.</p>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "Export", plan_template_path,
          class: "rounded-lg border border-stone-300 bg-white px-3 py-1.5 font-medium text-stone-700 hover:bg-stone-50" %>
    <%= form_with url: plan_template_path, method: :post, multipart: true, class: "flex items-center gap-2" do |f| %>
      <%= f.file_field :file, accept: "application/json", required: true,
            class: "block max-w-40 text-xs text-stone-500 file:mr-2 file:cursor-pointer file:rounded-lg file:border-0 file:bg-stone-100 file:px-2.5 file:py-1.5 file:text-xs file:font-medium file:text-stone-700 hover:file:bg-stone-200" %>
      <%= f.submit "Import", class: "cursor-pointer rounded-lg border border-stone-300 bg-white px-3 py-1.5 font-medium text-stone-700 hover:bg-stone-50" %>
    <% end %>
  </div>
</section>

<section class="mb-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
  <h2 class="mb-3 text-sm font-semibold text-stone-700">Add a subject</h2>
  <%= form_with model: @subject, url: subjects_path, class: "flex flex-wrap items-end gap-3" do |f| %>
    <div class="min-w-40 flex-1">
      <%= f.label :name, class: label_classes %>
      <%= f.text_field :name, placeholder: "e.g. Economics", class: input_classes %>
    </div>
    <div>
      <%= f.label :color, class: label_classes %>
      <%= f.color_field :color, value: "#0f766e", class: "h-[42px] w-16 rounded-lg border border-stone-300" %>
    </div>
    <div class="w-36">
      <%= f.label :weekly_target_minutes, "Weekly target (min)", class: label_classes %>
      <%= f.number_field :weekly_target_minutes, min: 1, class: input_classes %>
    </div>
    <%= f.submit "Add subject", class: "#{primary_button_classes} w-auto px-5" %>
  <% end %>
  <% if @subject.errors.any? %>
    <p class="mt-2 text-sm text-red-700"><%= @subject.errors.full_messages.to_sentence %></p>
  <% end %>
</section>

<section class="space-y-4">
  <% @subjects.each do |subject| %>
    <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-block h-3 w-3 rounded-full" style="background: <%= subject.color %>"></span>
          <p class="font-medium"><%= subject.name %></p>
          <% if subject.weekly_target_minutes %>
            <span class="text-xs text-stone-400"><%= subject.weekly_target_minutes %> min/week target</span>
          <% end %>
        </div>
        <div class="flex items-center gap-1 text-sm">
          <%= button_to "Archive", subject_path(subject), method: :patch, params: { subject: { archived: true } },
                form: { class: "inline" }, class: "cursor-pointer rounded-md px-2 py-1 text-stone-500 hover:bg-stone-100" %>
          <%= button_to "Delete", subject_path(subject), method: :delete,
                form: { class: "inline", data: { turbo_confirm: "Delete #{subject.name} and its topics?" } },
                class: "cursor-pointer rounded-md px-2 py-1 text-red-600 hover:bg-red-50" %>
        </div>
      </div>

      <ul class="mt-3 space-y-1.5">
        <% subject.topics.each do |topic| %>
          <li class="flex items-center justify-between gap-2 rounded-lg bg-stone-50 px-3 py-2 text-sm">
            <span><%= topic.name %></span>
            <span class="flex items-center gap-2">
              <span class="text-xs text-stone-400"><%= topic.done_tasks_count %>/<%= topic.tasks_count %> done</span>
              <%= button_to "×", topic_path(topic), method: :delete,
                    form: { data: { turbo_confirm: "Remove this topic?" } },
                    class: "cursor-pointer rounded px-1 text-stone-400 hover:bg-stone-200 hover:text-stone-600" %>
            </span>
          </li>
        <% end %>
      </ul>

      <%= form_with model: Topic.new, url: subject_topics_path(subject), class: "mt-3 flex gap-1.5" do |f| %>
        <%= f.text_field :name, placeholder: "Add a topic…", required: true,
              class: "block w-full rounded-lg border border-stone-300 bg-white px-2.5 py-1.5 text-sm placeholder:text-stone-400 focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20" %>
        <%= f.submit "Add", class: "cursor-pointer rounded-lg bg-stone-100 px-3 py-1.5 text-sm font-medium text-stone-700 hover:bg-stone-200" %>
      <% end %>
    </div>
  <% end %>
</section>

<% if @archived_subjects.any? %>
  <section class="mt-8">
    <h2 class="mb-2 text-sm font-semibold text-stone-500">Archived</h2>
    <ul class="space-y-1.5 text-sm text-stone-500">
      <% @archived_subjects.each do |subject| %>
        <li class="flex items-center justify-between rounded-lg bg-stone-50 px-3 py-2">
          <%= subject.name %>
          <%= button_to "Unarchive", subject_path(subject), method: :patch, params: { subject: { archived: false } },
                form: { class: "inline" }, class: "cursor-pointer rounded-md px-2 py-1 text-teal-700 hover:bg-teal-50" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
