<% day_labels = %w[Su Mo Tu We Th Fr Sa] %>
<%= form_with model: RecurringTask.new, url: recurring_tasks_path, class: "mb-3 space-y-1.5" do |f| %>
  <%= f.text_field :title, placeholder: "Add a recurring task…", required: true,
        class: "block w-full rounded-lg border border-stone-300 bg-white px-2.5 py-1.5 text-sm placeholder:text-stone-400 focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20" %>
  <div class="flex flex-wrap gap-1">
    <% day_labels.each_with_index do |label, wday| %>
      <label class="flex cursor-pointer items-center gap-1 rounded bg-stone-100 px-1.5 py-1 text-xs text-stone-600 has-[:checked]:bg-teal-100 has-[:checked]:text-teal-800">
        <%= check_box_tag "recurring_task[days_of_week][]", wday, false, id: "new_day_#{wday}", class: "sr-only" %>
        <%= label %>
      </label>
    <% end %>
  </div>
  <% if subjects.any? %>
    <%= f.grouped_collection_select :topic_id, subjects, :topics, :name, :id, :name,
          { include_blank: "No subject" },
          class: "block w-full rounded-lg border border-stone-300 bg-white px-2.5 py-1 text-xs text-stone-600 focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20" %>
  <% end %>
  <%= f.submit "Add", class: "cursor-pointer rounded-lg bg-stone-100 px-3 py-1.5 text-xs font-medium text-stone-700 hover:bg-stone-200" %>
<% end %>

<div class="space-y-2">
  <% recurring_tasks.each do |recurring_task| %>
    <div class="rounded-xl border border-stone-200 bg-white p-3 <%= 'opacity-50' unless recurring_task.active? %>">
      <div class="flex items-start justify-between gap-2">
        <p class="text-sm font-medium text-stone-900"><%= recurring_task.title %></p>
        <%= button_to recurring_task_path(recurring_task), method: :delete, title: "Delete",
              class: "cursor-pointer rounded px-1 text-stone-300 hover:bg-red-50 hover:text-red-500",
              form: { data: { turbo_confirm: "Remove this recurring task?" }, class: "leading-none" } do %>🗑<% end %>
      </div>
      <p class="mt-1 text-xs text-stone-400">
        <% day_labels.each_with_index do |label, wday| %>
          <span class="<%= recurring_task.days_of_week.include?(wday) ? 'text-teal-700 font-medium' : '' %>"><%= label %></span><%= " " %>
        <% end %>
      </p>
      <% if recurring_task.subject %>
        <span class="mt-1 inline-flex items-center gap-1 rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-500">
          <span class="inline-block h-2 w-2 rounded-full" style="background: <%= recurring_task.subject.color %>"></span>
          <%= recurring_task.subject.name %>
        </span>
      <% end %>
      <%= button_to toggle_recurring_task_path(recurring_task), method: :patch,
            class: "mt-2 cursor-pointer text-xs font-medium #{recurring_task.active? ? 'text-stone-500 hover:text-stone-700' : 'text-teal-700 hover:text-teal-800'}",
            form: { class: "leading-none" } do %>
        <%= recurring_task.active? ? "Pause" : "Resume" %>
      <% end %>
    </div>
  <% end %>
</div>
