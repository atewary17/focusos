<% content_for :title, "Board" %>

<div class="mb-6 flex items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">Board</h1>
  <%= link_to "Subjects & topics", subjects_path, class: "text-sm font-medium text-teal-700 hover:text-teal-800" %>
</div>

<% if @subjects.none? %>
  <section class="mb-6 rounded-2xl border border-dashed border-stone-300 p-5 text-sm text-stone-600">
    No subjects yet. <%= link_to "Add one", subjects_path, class: "font-medium text-teal-700" %> before adding cards,
    or add a card below without a subject.
  </section>
<% end %>

<div data-controller="board" data-reorder-url="<%= reorder_tasks_path %>"
     class="-mx-4 flex gap-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:grid sm:grid-cols-4 sm:overflow-visible sm:px-0">
  <% { "backlog" => "Backlog", "next" => "Next", "today" => "Today", "done" => "Done" }.each do |lane, label| %>
    <section class="w-64 shrink-0 sm:w-auto">
      <h2 class="mb-2 flex items-center justify-between text-sm font-semibold text-stone-700">
        <%= label %>
        <span class="text-xs font-normal text-stone-400"><%= @lanes[lane].size %></span>
      </h2>

      <%= form_with model: Task.new, url: tasks_path, class: "mb-2 space-y-1.5" do |f| %>
        <%= f.hidden_field :lane, value: lane %>
        <div class="flex gap-1.5">
          <%= f.text_field :title, placeholder: "Add a card…", required: true,
                class: "block w-full rounded-lg border border-stone-300 bg-white px-2.5 py-1.5 text-sm placeholder:text-stone-400 focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20" %>
          <%= f.submit "+", class: "shrink-0 cursor-pointer rounded-lg bg-stone-100 px-3 text-sm font-medium text-stone-600 hover:bg-stone-200" %>
        </div>
        <% if @subjects.any? %>
          <%= f.grouped_collection_select :topic_id, @subjects, :topics, :name, :id, :name,
                { include_blank: "No subject" },
                class: "block w-full rounded-lg border border-stone-300 bg-white px-2.5 py-1.5 text-xs text-stone-600 focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20" %>
        <% end %>
      <% end %>

      <div data-board-target="lane" data-lane="<%= lane %>" class="min-h-16 space-y-2 rounded-xl p-1">
        <% @lanes[lane].each do |task| %>
          <%= render "tasks/card", task: task %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
