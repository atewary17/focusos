<% content_for :title, "Plan" %>
<% content_for :container_class, "max-w-none" %>

<div class="mb-6 flex items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">Plan</h1>
  <%= link_to "Subjects & topics", subjects_path, class: "text-sm font-medium text-teal-700 hover:text-teal-800" %>
</div>

<% if @subjects.none? %>
  <section class="mb-6 rounded-2xl border border-dashed border-stone-300 p-5 text-sm text-stone-600">
    No subjects yet. <%= link_to "Add one", subjects_path, class: "font-medium text-teal-700" %> to tag cards, or add a card below without one.
  </section>
<% end %>

<div class="flex gap-6">
  <div data-controller="plan" data-reorder-url="<%= reorder_tasks_path %>"
       class="-mx-4 flex flex-1 gap-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0">
    <section class="w-64 shrink-0">
      <h2 class="mb-2 flex items-center justify-between text-sm font-semibold text-stone-500">
        Unscheduled
        <span class="text-xs font-normal text-stone-400"><%= @unscheduled.size %></span>
      </h2>
      <%= render "quick_add", scheduled_on: nil, subjects: @subjects %>
      <div data-plan-target="column" data-day="unscheduled" class="min-h-16 space-y-2 rounded-xl p-1">
        <%= render partial: "tasks/card", collection: @unscheduled, as: :task %>
      </div>
    </section>

    <% @days.each do |date| %>
      <section class="w-72 shrink-0">
        <div class="mb-2">
          <h2 class="flex items-center justify-between text-sm font-semibold text-stone-700">
            <%= date == Date.current ? "Today" : date.strftime("%A") %>
            <span class="text-xs font-normal text-stone-400"><%= @minutes_by_day[date] %>m</span>
          </h2>
          <p class="text-xs text-stone-400"><%= date.strftime("%-d %B") %></p>
          <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-stone-100">
            <div class="h-full rounded-full <%= @minutes_by_day[date] > @day_capacity_minutes ? 'bg-amber-500' : 'bg-teal-600' %>"
                 style="width: <%= [ @minutes_by_day[date].to_f / @day_capacity_minutes * 100, 100 ].min %>%"></div>
          </div>
        </div>
        <%= render "quick_add", scheduled_on: date, subjects: @subjects %>
        <div data-plan-target="column" data-day="<%= date.iso8601 %>" class="min-h-16 space-y-2 rounded-xl p-1">
          <%= render partial: "tasks/card", collection: @tasks_by_day[date], as: :task %>
        </div>
      </section>
    <% end %>
  </div>

  <aside class="hidden w-72 shrink-0 lg:block">
    <h2 class="mb-2 text-sm font-semibold text-stone-700">Today's timeline</h2>
    <%= render "timeline", tasks: @timeline_tasks %>
  </aside>
</div>
