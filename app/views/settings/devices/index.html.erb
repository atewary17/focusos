<% content_for :title, "Devices" %>

<p class="mb-2 text-sm"><%= link_to "← Settings", account_path, class: "text-stone-500 hover:text-stone-800" %></p>
<h1 class="mb-2 text-2xl font-semibold tracking-tight">Devices</h1>
<p class="mb-8 text-sm text-stone-500">Phones signed in to the FocusOS Android app.</p>

<% if @devices.none? %>
  <section class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <p class="text-sm text-stone-500">No devices yet. Sign in from the Android app to add one.</p>
  </section>
<% end %>

<div class="space-y-4">
  <% @devices.each do |device| %>
    <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="font-medium"><%= device.name %></p>
          <p class="text-sm text-stone-500">
            <%= [ device.manufacturer, device.model ].compact_blank.join(" ") %>
            <%= "· Android #{device.os_version}" if device.os_version.present? %>
            <%= "· app #{device.app_version}" if device.app_version.present? %>
          </p>
        </div>
        <% if device.signed_in? %>
          <%= button_to "Sign out", settings_device_path(device), method: :delete,
                class: "cursor-pointer rounded-lg border border-stone-300 px-3 py-1.5 text-sm text-stone-700 hover:bg-stone-50",
                form: { data: { turbo_confirm: "Sign out #{device.name}? Its uploaded data is kept." } } %>
        <% else %>
          <span class="rounded-full bg-stone-100 px-2.5 py-1 text-xs text-stone-600">Signed out</span>
        <% end %>
      </div>
      <%= render "shared/device_status", device: device %>
    </section>
  <% end %>
</div>
